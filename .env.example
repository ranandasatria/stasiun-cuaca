# Copy this file to .env to override the compose defaults.
# The real .env is git ignored and must never be committed.

# PostgreSQL container
POSTGRES_USER=cuaca
POSTGRES_PASSWORD=cuaca
POSTGRES_DB=cuaca
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:3000

# Local dev only (running the backend on the host instead of docker)
DATABASE_URL=postgresql://cuaca:cuaca@localhost:5432/cuaca?schema=public
