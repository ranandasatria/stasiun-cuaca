// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  PROVISIONED
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum QualityFlag {
  GOOD
  OUT_OF_RANGE
  SENSOR_ERROR
  FUTURE_TS
  STUCK
  COUNTER_RESET
}

model Location {
  id        Int     @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  altitude  Float

  @@map("locations")
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String @map("password_hash")
  role         String @default("admin")

  @@map("users")
}

model SensorType {
  code        String @id
  displayName String @map("display_name")
  unit        String
  minValid    Float  @map("min_valid")
  maxValid    Float  @map("max_valid")
  precision   Int

  @@map("sensor_types")
}
