// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  PROVISIONED
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum QualityFlag {
  GOOD
  OUT_OF_RANGE
  SENSOR_ERROR
  FUTURE_TS
  STUCK
  COUNTER_RESET
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  altitude  Float
  devices   Device[]

  @@map("locations")
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String @map("password_hash")
  role         String @default("admin")

  @@map("users")
}

model SensorType {
  code        String @id
  displayName String @map("display_name")
  unit        String
  minValid    Float  @map("min_valid")
  maxValid    Float  @map("max_valid")
  precision   Int

  @@map("sensor_types")
}

model Device {
  id            String       @id
  name          String
  locationId    Int          @map("location_id")
  status        DeviceStatus @default(PROVISIONED)
  apiKeyHash    String       @map("api_key_hash")
  apiKeyPrefix  String       @map("api_key_prefix")
  lastSeenAt    DateTime?    @map("last_seen_at")
  lastBatteryV  Float?       @map("last_battery_v")
  lastRssi      Int?         @map("last_rssi")
  lastFwVersion String?      @map("last_fw_version")
  deletedAt     DateTime?    @map("deleted_at")

  location      Location              @relation(fields: [locationId], references: [id])
  statusHistory DeviceStatusHistory[]

  @@index([lastSeenAt])
  @@map("devices")
}

model DeviceStatusHistory {
  id         Int          @id @default(autoincrement())
  deviceId   String       @map("device_id")
  fromStatus DeviceStatus @map("from_status")
  toStatus   DeviceStatus @map("to_status")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  device     Device       @relation(fields: [deviceId], references: [id])

  @@map("device_status_histories")
}
